# Copy to .env and fill in. Pass one or more env files on the command line:
#   csp-ical .env
# Later files override earlier ones, so you can share iCloud settings
# across patrollers: csp-ical .env.icloud .env.patroller

# CSP Roster account
CSP_BASE=https://lakelouise.csproster.ca
CSP_LOGIN=your-login
CSP_PASSWORD=your-password
CSP_VOID=1848

# iCloud CalDAV
ICLOUD_USER=you@example.com
# Create at https://account.apple.com > Sign-In and Security > App-Specific Passwords
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Run `csp-ical --list-calendars .env` to see available names
ICLOUD_CALENDAR=Patrol

# Optional
# TZ_NAME=America/Edmonton
# SHIFT_START=08:00   # fallback for past shifts only
# SHIFT_END=16:00
# LOCATION=1 Whitehorn Road, Lake Louise, Alberta, Canada, T0L 1E0
# TITLE_PREFIX=⛑️
# FIRST_NAME=Jane     # defaults to the name on the roster page
